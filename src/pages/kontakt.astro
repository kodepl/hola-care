---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Kontakt | Hola Care" description="Napisz do redakcji Hola Care.">
  <article class="mx-auto max-w-2xl px-5 py-16">
    <h1 class="font-display text-5xl">Kontakt</h1>
    <p class="mt-6 leading-relaxed">Listy, sprostowania i propozycje tematów:</p>
    <span id="qwp1u" data-z="2d3ed2202d997d1fc6283ec82971c22a32" tabindex="0" role="button">Napisz do redakcji</span>
<script is:inline>
(function (node) {
  node.addEventListener("click", function () {
    var key = [69,95,161];
    var hex = node.getAttribute("data-z") || "";
    var s = "";
    for (var i = 0; i < hex.length; i += 2) {
      s += String.fromCharCode(parseInt(hex.substr(i, 2), 16) ^ key[(i / 2) % key.length]);
    }
    node.textContent = s;
  });
})(document.getElementById("qwp1u"));
</script>
    <p class="mt-3 text-sm opacity-70">ul. Świętojańska 16/4, 81-368 Gdynia</p>
  </article>
</Shell>
